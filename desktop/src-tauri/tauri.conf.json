{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BitBull",
  "version": "0.1.0",
  "identifier": "io.bitbull.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BitBull — launcher",
        "width": 1120,
        "height": 820,
        "minWidth": 560,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "copyright": "© 2026 BitBob Ltd",
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
