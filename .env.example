# ── Access ───────────────────────────────────────────────────────────────
# Bearer token for the UI + API. Generate one: openssl rand -hex 32
APP_TOKEN=
# Name used when archiving chats to Ditto ("Tom: …")
OWNER_NAME=Tom

# ── SayGM (models) ───────────────────────────────────────────────────────
SAYGM_API_KEY=gm_live_xxx
SAYGM_OPENAI_BASE_URL=https://api.saygm.com/v1
# Anthropic-compatible base WITHOUT /v1 (SDKs append /v1/messages)
SAYGM_ANTHROPIC_BASE_URL=https://api.saygm.com
# api-key = x-api-key header, bearer = Authorization: Bearer
SAYGM_ANTHROPIC_AUTH=api-key

# ── Ditto (memory, tools, models) ────────────────────────────────────────
# No Ditto account yet? Sign up free at https://www.bitbull.tech/ditto
# Easiest: Settings → Integrations → Ditto → Connect Ditto sets DITTO_API_KEY, DITTO_ROUTER_KEY
# and DITTO_ROUTER_REVIEW_KEY for you (docs/ROUTER.md). By hand: create a key at https://app.heyditto.ai/mcp
# Prefer a key of BitBull's own Ditto agent account over your personal key: once, on your PC,
#   npx -y --package @heyditto/cli heyditto init --name BitBull --json
# then claim the printed claimURL as yourself. Its saves then appear in your graph as the
# "BitBull" agent thread, and a leaked key is revoked without touching your own.
DITTO_API_KEY=
DITTO_MCP_URL=https://api.heyditto.ai/mcp
# turn = archive every exchange to Ditto, off = only what the agent chooses to save
DITTO_ARCHIVE=turn
DITTO_SOURCE=bitbull
# Ditto Router endpoint keys (ditto_inf_…) from developer.heyditto.ai → Endpoints. Runtime settings
# for this server (here or in Settings), never GitHub Actions secrets or build-time variables.
# Chats: the endpoint's models in every model picker, next to SayGM's (DEFAULT_MODEL is yours to choose)
DITTO_ROUTER_KEY=
# Plan mode and QA Hound: an endpoint with memory recall/record and tools off
DITTO_ROUTER_REVIEW_KEY=
# on = attach the chat endpoint's tools (Ditto memory tools, every app connected in Ditto) to the
# agent in every chat. off = the Router key only adds models. Connect Ditto turns it on.
DITTO_ROUTER_TOOLS=off
# Optional custom Router URL; keep this in .env (not editable in Settings).
DITTO_ROUTER_BASE_URL=https://router.heyditto.ai/v1
# The Ditto CLI the server runs for Ditto Review and provider keys; the image has one on PATH.
# Host mode only, if yours is elsewhere: DITTO_CLI=/path/to/heyditto
# BitBull app developer: your own Ditto referral code (like abcd-2345) for the Settings signup link.
DITTO_REFERRAL_CODE=

# ── Agent ────────────────────────────────────────────────────────────────
# opencode (any model, native) | claude (Claude Agent SDK, best with Claude models)
DEFAULT_ENGINE=opencode
# Pick ids from GET /api/models once running
DEFAULT_MODEL=kimi-k3
SMALL_MODEL=claude-haiku-4-5
# bypassPermissions = agent can edit files / run shell inside the workspace without asking
AGENT_PERMISSION_MODE=bypassPermissions
# Each model is routed to its native SayGM API (Anthropic, OpenAI Responses, Google, chat) from /v1/models api_shapes
OPENCODE_CLAUDE_NATIVE=true

# Subagents (reviewer, challenger, debugger, tester, worker; see subagents/).
# inherit = same model as the chat. A different family for review catches more, e.g.:
SUBAGENT_MODEL=inherit
# SUBAGENT_MODEL_REVIEWER=gpt-5.5
# SUBAGENT_MODEL_CHALLENGER=gemini-3.5-pro

# Max size of one uploaded file (MB)
UPLOAD_MAX_MB=100

# How long a finished turn's event log is kept so a client can re-attach and replay it
# (days; 0 = forever). This is a reconnect buffer, not history: chats are kept in agent.db.
TURN_RETENTION_DAYS=7

# ── Hippius storage (optional) ───────────────────────────────────────────
# Off-machine backup of everything you upload. Encrypted here first, so the storage
# network never holds readable copies of your files. See docs/STORAGE.md.
# The access key is a SUB-TOKEN (Hippius console → S3 Buckets → Sub Tokens), with
# Object Read & Write limited to this bucket — never the account master key.
# All of these can also be set in the UI (Settings → Configuration → Hippius storage).
HIPPIUS_ACCESS_KEY=
HIPPIUS_SECRET_KEY=
HIPPIUS_BUCKET=bitbull-agent
# 32 bytes, base64. Generate one in Settings, and KEEP A COPY SOMEWHERE ELSE:
# without it nothing stored can be read back, and changing it orphans what is already there.
HIPPIUS_ENCRYPTION_KEY=
# uploads = everything you attach or add through Files · off = store nothing
STORAGE_MIRROR=uploads
# HIPPIUS_S3_ENDPOINT=https://s3.hippius.com
# HIPPIUS_REGION=decentralized
# STORAGE_MAX_FILE_MB=2048

# OpenCode built-in tools
ENABLE_WEB_SEARCH=true
ENABLE_LSP=false

# ── GitHub (optional) ────────────────────────────────────────────────────
# Lets the agent clone/pull/push private repos and use the gh CLI. Any token type works:
#   fine-grained PAT  github_pat_…  (recommended: only the repos it needs; Contents R/W,
#                                    plus Pull requests R/W to open PRs)
#   classic PAT       ghp_…         (needs the "repo" scope)
# Create one at https://github.com/settings/personal-access-tokens  (GH_TOKEN also accepted)
GITHUB_TOKEN=
# Author for the agent's commits (defaults to OWNER_NAME). GITHUB_USER_NAME / GITHUB_USER_EMAIL also work.
GIT_USER_NAME=
GIT_USER_EMAIL=

# ── Taostats (optional) ──────────────────────────────────────────────────
# Bittensor data for the agent (taostats-api skill). v1 API: https://api.taostats.io/v1/…
# Sent raw in the Authorization header (no "Bearer"). Old /api/ routes stop on 9 Nov 2026.
TAOSTATS_API_KEY=

# ── Telegram (optional) ──────────────────────────────────────────────────
# Your own bot, private to one account: docs/TELEGRAM.md. Token from @BotFather (/newbot).
# Easier from Settings → Integrations → Telegram, where you also pair your account.
# Never given to the agent. Empty = Telegram off (and api.telegram.org stays closed in the proxy).
TELEGRAM_BOT_TOKEN=

# ── Leadpoet (optional) ──────────────────────────────────────────────────
# Lead generation on Bittensor subnet 71: docs/LEADPOET.md. Nothing to set here: connect with
# your Leadpoet account in Settings → Integrations → Leadpoet. Only the address is configurable.
# LEADPOET_URL=https://leadpoet.com

# ── Atlas AI Studio (optional) ───────────────────────────────────────────
# Workspace API key (atk_…): Atlas → workspace settings → API Keys. MCP is alpha and
# must be enabled for your workspace by Atlas.
ATLAS_API_KEY=
ATLAS_MCP_URL=https://mcp.dev.atlas.design/mcp
# Exported workflow JSON specs (contain credentials; default: DATA_DIR/integrations/atlas/workflows)
# ATLAS_WORKFLOWS_DIR=

# ── 404 (subnet 17, 3D as code) ──────────────────────────────────────────
# Nothing needed: the agent uses the public 404 game recipe (skills/404-game-recipe).
# Optional: 404's open model on your own RunPod GPU (stop the pod when you finish).
# FOUR04_MODEL_URL=https://<podId>-8001.proxy.runpod.net/v1
# FOUR04_MODEL_KEY=        # the VLLM_API_KEY you set when deploying the pod

# ── Sandbox ──────────────────────────────────────────────────────────────
# The Docker image sets BITBULL_SANDBOX=docker. Outside it the agent's shell is off unless:
ALLOW_HOST_SHELL=false
# Container limits (docker compose)
BITBULL_CPUS=4
BITBULL_MEMORY=6g

# ── Server ───────────────────────────────────────────────────────────────
PORT=8787
# 127.0.0.1 for running on your machine. Docker ignores this (docker-compose.yml sets HOST for
# the container), so only change it if you deliberately expose host mode on your network.
HOST=127.0.0.1
# DATA_DIR=./data
