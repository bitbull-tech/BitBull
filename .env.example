# ── Access ───────────────────────────────────────────────────────────────
# Bearer token for the UI + API. Generate one: openssl rand -hex 32
APP_TOKEN=
# Name used when archiving chats to Ditto ("Tom: …")
OWNER_NAME=Tom

# ── SayGM (models) ───────────────────────────────────────────────────────
SAYGM_API_KEY=gm_live_xxx
SAYGM_OPENAI_BASE_URL=https://api.saygm.com/v1
# Anthropic-compatible base WITHOUT /v1 (SDKs append /v1/messages)
SAYGM_ANTHROPIC_BASE_URL=https://api.saygm.com
# api-key = x-api-key header, bearer = Authorization: Bearer
SAYGM_ANTHROPIC_AUTH=api-key

# ── Ditto (memory) ───────────────────────────────────────────────────────
# Create a key at https://app.heyditto.ai/mcp
DITTO_API_KEY=
DITTO_MCP_URL=https://api.heyditto.ai/mcp
# turn = archive every exchange to Ditto, off = only what the agent chooses to save
DITTO_ARCHIVE=turn
DITTO_SOURCE=bitbob

# ── Agent ────────────────────────────────────────────────────────────────
# opencode (any model, native) | claude (Claude Agent SDK, best with Claude models)
DEFAULT_ENGINE=opencode
# Pick ids from GET /api/models once running
DEFAULT_MODEL=kimi-k3
SMALL_MODEL=claude-haiku-4-5
# bypassPermissions = agent can edit files / run shell inside the workspace without asking
AGENT_PERMISSION_MODE=bypassPermissions
# Each model is routed to its native SayGM API (Anthropic, OpenAI Responses, Google, chat) from /v1/models api_shapes
OPENCODE_CLAUDE_NATIVE=true

# Subagents (reviewer, challenger, debugger, tester, worker, fact-checker; see subagents/).
# inherit = same model as the chat. A different family for review catches more, e.g.:
SUBAGENT_MODEL=inherit
# SUBAGENT_MODEL_REVIEWER=gpt-5.5
# SUBAGENT_MODEL_CHALLENGER=gemini-3.5-pro

# Max size of one uploaded file (MB)
UPLOAD_MAX_MB=100

# How long a finished turn's event log is kept so a client can re-attach and replay it
# (days; 0 = forever). This is a reconnect buffer, not history: chats are kept in agent.db.
TURN_RETENTION_DAYS=7

# ── Hippius storage (optional) ───────────────────────────────────────────
# Off-machine backup of everything you upload. Encrypted here first, so the storage
# network never holds readable family photos. See docs/STORAGE.md.
# The access key is a SUB-TOKEN (Hippius console → S3 Buckets → Sub Tokens), with
# Object Read & Write limited to this bucket — never the account master key.
# All of these can also be set in the UI (Settings → Configuration → Hippius storage).
HIPPIUS_ACCESS_KEY=
HIPPIUS_SECRET_KEY=
HIPPIUS_BUCKET=bitbob-agent
# 32 bytes, base64. Generate one in Settings, and KEEP A COPY SOMEWHERE ELSE:
# without it nothing stored can be read back, and changing it orphans what is already there.
HIPPIUS_ENCRYPTION_KEY=
# uploads = everything you attach or add through Files · off = store nothing
STORAGE_MIRROR=uploads
# HIPPIUS_S3_ENDPOINT=https://s3.hippius.com
# HIPPIUS_REGION=decentralized
# STORAGE_MAX_FILE_MB=2048

# OpenCode built-in tools
ENABLE_WEB_SEARCH=true
ENABLE_LSP=false

# ── GitHub (optional) ────────────────────────────────────────────────────
# Lets the agent clone/pull/push private repos and use the gh CLI. Any token type works:
#   fine-grained PAT  github_pat_…  (recommended: only the repos it needs; Contents R/W,
#                                    plus Pull requests R/W to open PRs)
#   classic PAT       ghp_…         (needs the "repo" scope)
# Create one at https://github.com/settings/personal-access-tokens  (GH_TOKEN also accepted)
GITHUB_TOKEN=
# Author for the agent's commits (defaults to OWNER_NAME). GITHUB_USER_NAME / GITHUB_USER_EMAIL also work.
GIT_USER_NAME=
GIT_USER_EMAIL=

# ── Taostats (optional) ──────────────────────────────────────────────────
# Bittensor data for the agent (taostats-api skill). v1 API: https://api.taostats.io/v1/…
# Sent raw in the Authorization header (no "Bearer"). Old /api/ routes stop on 9 Nov 2026.
TAOSTATS_API_KEY=

# ── Atlas AI Studio (optional) ───────────────────────────────────────────
# Workspace API key (atk_…): Atlas → workspace settings → API Keys. MCP is alpha and
# must be enabled for your workspace by Atlas.
ATLAS_API_KEY=
ATLAS_MCP_URL=https://mcp.dev.atlas.design/mcp
# Exported workflow JSON specs (contain credentials; default: DATA_DIR/integrations/atlas/workflows)
# ATLAS_WORKFLOWS_DIR=

# ── 404.xyz / 404—GEN (optional, reserved until 404 publishes an API) ────
FOUR04_API_BASE=
FOUR04_API_KEY=
FOUR04_MCP_URL=

# ── Heritage experiences ────────────────────────────────────────────────
# ground-only: real people only via their original images (default)
# private-likeness: allow animating family photos in private, labelled projects
HERITAGE_LIKENESS_POLICY=ground-only

# ── Sandbox ──────────────────────────────────────────────────────────────
# The Docker image sets BITBOB_SANDBOX=docker. Outside it the agent's shell is off unless:
ALLOW_HOST_SHELL=false
# Container limits (docker compose)
BITBOB_CPUS=4
BITBOB_MEMORY=6g

# ── Server ───────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
# DATA_DIR=./data
