{
  "manifest_version": 3,
  "name": "BitBull: send this page",
  "short_name": "BitBull",
  "version": "0.1.0",
  "description": "Send the page you're looking at to your local BitBull to review: a screenshot plus its text, outline, links and quick checks.",
  "author": "BitBob Ltd",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_title": "Send this page to BitBull",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+B" }, "description": "Send this page to BitBull" }
  }
}
